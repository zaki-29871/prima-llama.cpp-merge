+    }
+#elif defined(__linux__)
+    const char * os = get_uname_os(); 
+    if (strstr(os, "Android") != nullptr) {
+        std::unique_ptr<FILE, decltype(&pclose)> pipe(popen("getprop ro.product.model", "r"), pclose);
+        if (pipe) {
