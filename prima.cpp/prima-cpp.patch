+static const char * get_uname_os() {
+    std::unique_ptr<FILE, decltype(&pclose)> pipe(popen("uname -o", "r"), pclose);
+    if (!pipe) {
+        return "Unknown"; 
+    }
+
+    static char buffer[16]; 
+    if (fgets(buffer, sizeof(buffer), pipe.get()) != nullptr) {
+        buffer[strcspn(buffer, "\n")] = '\0';
+        return buffer; 
+    }
+    return "Unknown"; 
+}
